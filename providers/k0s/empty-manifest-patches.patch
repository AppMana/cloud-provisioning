index 51fd4c5d..476c96fe 100644
--- a/internal/pkg/patches/patches.go
+++ b/internal/pkg/patches/patches.go
@@ -54,6 +54,11 @@ func applyToDoc(doc []byte, patches v1beta1.Patches) ([]byte, error) {
 	if err != nil {
 		return nil, fmt.Errorf("failed to parse manifest document: %w", err)
 	}
+	// Optional templates can render only a separator or comments. Such YAML
+	// documents have no resource to patch; preserve them as with no patches.
+	if bytes.Equal(bytes.TrimSpace(jsonDoc), []byte("null")) {
+		return doc, nil
+	}
 	if err := obj.UnmarshalJSON(jsonDoc); err != nil {
 		return nil, fmt.Errorf("failed to decode manifest document: %w", err)
 	}
