+++ b/plugins/vpc-bridge/network/forwarding_windows_test.go
@@ -0,0 +1,47 @@
+package network
+
+import (
+	"encoding/json"
+	"os/exec"
+	"testing"
+)
+
+func TestHostForwardingOwnership(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		success bool
+		sets    int
+	}{
+		{"enable", true, 1}, {"idempotent", true, 0},
+		{"foreign-network", false, 0}, {"foreign-ip", false, 0}, {"foreign-type", false, 0},
+		{"foreign-mac", false, 0}, {"physical-target", false, 0}, {"ambiguous-ip", false, 0},
+		{"replaced", false, 1}, {"readback-failure", false, 1},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cmd := exec.Command("powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "test-forwarding.ps1", "-Case", tc.name)
+			out, err := cmd.Output()
+			if (err == nil) != tc.success {
+				t.Fatalf("unexpected result: %v; output: %s", err, out)
+			}
+			var result struct {
+				Sets  int `json:"sets"`
+				Reads int `json:"reads"`
+			}
+			if err := json.Unmarshal(out, &result); err != nil {
+				t.Fatal(err)
+			}
+			if result.Sets != tc.sets {
+				t.Fatalf("mutations=%d, want %d", result.Sets, tc.sets)
+			}
+			if tc.success && result.Reads != 2 {
+				t.Fatalf("forwarding was not read before and after setup")
+			}
+		})
+	}
+}
+
+func TestHostForwardingOmitted(t *testing.T) {
+	if err := (&BridgeBuilder{}).enableHostRouteForwarding(&Network{}); err != nil {
+		t.Fatal(err)
+	}
+}
