{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ObserveVPCCNIAllocations",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeSubnets"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}"
        }
      }
    }
  ]
}
