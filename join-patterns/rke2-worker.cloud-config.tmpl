#cloud-config
# rke2-agent join pattern: download the pinned dialer binary, bring up
# the WireGuard tunnel, gate on the cluster's supervisor becoming
# reachable through it, then join as a plain RKE2 agent using a
# pre-minted bootstrap token in the same secure format as k3s
# (K10<CA-hash>::<id>.<secret>; RKE2 is k3s's server code with its
# supervisor on 9345, see pkg/join/rke2). Set directly as
# Machine.spec.bootstrap.dataSecretName content, with no bootstrap
# provider; the other patterns are the same contract.
#
# Only write_files and runcmd belong here, for the same reason as the
# kubeadm pattern: CAPD-style interpreters parse any other top-level
# module with an "unknown" handler that fails on plain YAML.
#
# The dialer's loopback balancer flag appears nowhere in this file,
# deliberately: the RKE2 agent carries the same client-side balancer
# as k3s across every server it learns from the supervisor, so ours
# would be a second balancer stacked on a working one
# (join-patterns/README.md tracks who balances per distribution).
write_files:
  # Same hardened dialer, same separation of concerns as the other
  # patterns: pod/service CIDRs only ever enter WireGuard's cryptokey
  # accept-list; kernel routes are /32-/128 host routes to peer nodes,
  # enforced at parse time. This file is the BOOTSTRAP snapshot; the
  # wg-dialer-cloud DaemonSet supplies the live peer list post-join
  # (--machine-name-file resolves this machine's adoption Secret).
  - path: /etc/wg-dialer/peers.json
    permissions: '0600'
    content: |
      {{ .peersFileJSON }}
  - path: /etc/wg-dialer/machine-name
    permissions: '0644'
    content: |
      {{ .machineName }}
  - path: /etc/systemd/system/wg-dialer.service
    permissions: '0644'
    content: |
      [Unit]
      Description=wg-dialer (listener role)
      After=network-online.target
      Wants=network-online.target

      [Service]
      ExecStart=/usr/local/bin/wg-dialer \
        --iface={{ .interfaceName }} \
        --peers-file=/etc/wg-dialer/peers.json \
        --listen-port={{ .wireguardListenPort }} \
        --keepalive-seconds=15 \
        --mtu=1420 \
        --poll-interval=30s
      Restart=always
      # Re-exec hourly so the unit converges onto whatever binary is at
      # the path: after the node joins, the wg-dialer-cloud DaemonSet
      # installs its own (image-carried, digest-pinned) binary there,
      # which is how upgrades reach this floor without a download host
      # or any per-node action. Restart is <1s and the tunnel config is
      # idempotent, so the re-exec is not a disruption.
      RuntimeMaxSec=1h
      AmbientCapabilities=CAP_NET_ADMIN

      [Install]
      WantedBy=multi-user.target
  # The token in a root-only file rather than on a command line, read
  # by the agent through its config's token-file key.
  - path: /etc/rancher/rke2/join-token
    permissions: '0600'
    content: |
      {{ .joinToken }}
  # The agent's own config. kubelet args and any metadata-derived
  # node-ip are appended in runcmd, because they are computed on the
  # machine.
  - path: /etc/rancher/rke2/config.yaml
    permissions: '0600'
    content: |
      server: {{ .joinServerURL }}
      token-file: /etc/rancher/rke2/join-token
runcmd:
  # Pinned-digest binary delivery, identical to the other patterns: a
  # mismatch halts the join rather than running unverified code.
  # Download to a temp path and rename into place: a re-run of this
  # bootstrap (cloud-init reruns, an infrastructure provider retrying)
  # would otherwise try to write a binary that is already executing,
  # and the kernel refuses that (ETXTBSY), which curl reports as an
  # opaque write failure. Rename replaces the directory entry and
  # works regardless.
  - |
    set -e
    case "$(uname -m)" in
      aarch64|arm64) url='{{ .dialerBinaryURLArm64 }}'; sha='{{ .dialerBinarySHA256Arm64 }}' ;;
      x86_64|amd64)  url='{{ .dialerBinaryURLAmd64 }}'; sha='{{ .dialerBinarySHA256Amd64 }}' ;;
      *) echo "no wg-dialer build for $(uname -m)" >&2; exit 1 ;;
    esac
    [ -n "$url" ] || { echo "no wg-dialer URL configured for $(uname -m)" >&2; exit 1; }
    curl -fsSL -o /usr/local/bin/.wg-dialer.new "$url"
    echo "$sha  /usr/local/bin/.wg-dialer.new" | sha256sum -c -
    chmod 0755 /usr/local/bin/.wg-dialer.new
    mv -f /usr/local/bin/.wg-dialer.new /usr/local/bin/wg-dialer
  - systemctl daemon-reload
  - systemctl enable --now wg-dialer.service
  # Gate on the supervisor the join will actually dial, through the
  # tunnel. Its /ping answers unauthenticated, and any HTTP response
  # proves reachability. TCP rather than ICMP for the same reasons as
  # every other pattern: minimal images ship no ping, and cloud
  # firewalls drop ICMP while admitting the port that matters.
  - until curl -sk --max-time 3 -o /dev/null {{ .joinServerURL }}/ping; do sleep 2; done
  # kubeletExtraArgs arrive as one opaque string of --flag=value words
  # (the generic contract); RKE2 takes kubelet args one per kubelet-arg
  # config entry, so the string is re-worded here. The values this
  # operator renders (a role label, a taint) contain no whitespace, so
  # word-splitting is the correct parser for them. node-ip from
  # instance metadata where a metadata service exists (IMDSv2,
  # AWS-specific); where there is none the probe fails fast and RKE2's
  # own address detection applies unchanged.
  - |
    set -e
    KEXTRA='{{ .kubeletExtraArgs }}'
    if [ -n "$KEXTRA" ]; then
      echo 'kubelet-arg:' >> /etc/rancher/rke2/config.yaml
      for a in $KEXTRA; do
        echo "  - \"${a#--}\"" >> /etc/rancher/rke2/config.yaml
      done
    fi
    IMDS_TOKEN=$(curl -sf -m 2 -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60" || true)
    if [ -n "$IMDS_TOKEN" ]; then
      NODE_IPV4=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4 || true)
      NODE_IPV6=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/ipv6 || true)
      if [ -n "$NODE_IPV4" ] && [ -n "$NODE_IPV6" ]; then
        echo "node-ip: $NODE_IPV4,$NODE_IPV6" >> /etc/rancher/rke2/config.yaml
      elif [ -n "$NODE_IPV4" ]; then
        echo "node-ip: $NODE_IPV4" >> /etc/rancher/rke2/config.yaml
      fi
    fi
    echo "node-name: $(hostname)" >> /etc/rancher/rke2/config.yaml
    curl -sfL https://get.rke2.io | INSTALL_RKE2_VERSION='{{ .rke2Version }}' INSTALL_RKE2_TYPE=agent sh -
    systemctl enable --now rke2-agent.service
  # CAPI's bootstrap-success sentinel, same contract as the other
  # patterns: this pattern takes the bootstrap provider's place, so it
  # honors what infrastructure providers poll for.
  - mkdir -p /run/cluster-api
  - touch /run/cluster-api/bootstrap-success.complete
