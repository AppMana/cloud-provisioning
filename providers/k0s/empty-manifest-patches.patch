+
+func TestApply_EmptyRenderedDocuments(t *testing.T) {
+	customizations := v1beta1.Patches{{
+		Target: v1beta1.PatchTarget{Kind: "ConfigMap", Name: "my-config"},
+		Patch:  v1beta1.PatchSpec{Type: v1beta1.MergePatchType, Content: `{"data":{"key":"patched"}}`},
+	}}
+	for _, empty := range []string{"---\n", "---\n# Optional resource disabled\n", "null\n", "~\n"} {
+		t.Run(empty, func(t *testing.T) {
+			out, err := patches.Apply([]byte(empty), customizations)
+			require.NoError(t, err)
+			value, err := yaml.YAMLToJSON(out)
+			require.NoError(t, err)
+			require.Equal(t, "null", string(value))
+			out, err = patches.Apply([]byte(empty+"---\n"+cmManifest), customizations)
+			require.NoError(t, err)
+			require.Contains(t, string(out), "patched")
+		})
+	}
+	_, err := patches.Apply([]byte("metadata:\n  name: missing-kind\n"), customizations)
+	require.Error(t, err, "nonempty malformed resources must still fail")
+}
