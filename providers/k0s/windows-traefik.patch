 		})
 	}
 }
+
+// An existing routing.yaml is read-only in k0s 1.36.2. On Windows, the
+// replacement rename fails even though the process owns the directory.
+func TestTraefikReplacesExistingReadOnlyConfig(t *testing.T) {
+	directory := t.TempDir()
+	path := filepath.Join(directory, traefikRoutingConfigFileName)
+	require.NoError(t, os.WriteFile(path, []byte("old"), 0444))
+	t.Cleanup(func() { _ = os.Chmod(path, 0644) })
+	underTest := traefik{dir: directory}
+	for _, content := range []string{"new", "newer"} {
+		require.NoError(t, underTest.writeConfigFile(traefikRoutingConfigFileName, []byte(content)))
+		actual, err := os.ReadFile(path)
+		require.NoError(t, err)
+		require.Equal(t, content, string(actual))
+	}
+}
