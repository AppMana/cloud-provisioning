diff --git a/pkg/component/controller/konnectivity_leases_test.go b/pkg/component/controller/konnectivity_leases_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/component/controller/konnectivity_leases_test.go
@@ -0,0 +1,61 @@
+// SPDX-FileCopyrightText: 2026 k0s authors
+// SPDX-License-Identifier: Apache-2.0
+
+package controller
+
+import (
+	"github.com/k0sproject/k0s/pkg/apis/k0s/v1beta1"
+	"github.com/k0sproject/k0s/pkg/component/prober"
+	"github.com/k0sproject/k0s/pkg/config"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	rbacv1 "k8s.io/api/rbac/v1"
+	"k8s.io/cli-runtime/pkg/resource"
+	"k8s.io/client-go/kubernetes/scheme"
+	"testing"
+)
+
+func TestKonnectivityLeaseDiscovery(t *testing.T) {
+	server := Konnectivity{Spec: v1beta1.DefaultKonnectivitySpec(), K0sVars: &config.CfgVars{}}
+	args := server.serverArgs()
+	require.Contains(t, args, "--enable-lease-controller=true")
+	for _, arg := range args {
+		require.NotContains(t, arg, "--server-count=")
+	}
+	for _, hostNetwork := range []bool{false, true} {
+		cfg := v1beta1.DefaultClusterConfig()
+		cfg.Spec.Network.NodeLocalLoadBalancing = &v1beta1.NodeLocalLoadBalancing{Enabled: hostNetwork, Type: v1beta1.NllbTypeTraefik, Traefik: v1beta1.DefaultTraefik()}
+		dir := t.TempDir()
+		agent := KonnectivityAgent{ManifestsDir: dir, KonnectivityServerHost: "api.example.test", EventEmitter: prober.NewEventEmitter(), log: logrus.NewEntry(logrus.New())}
+		require.NoError(t, agent.writeKonnectivityAgent(cfg))
+		objects, err := resource.NewLocalBuilder().WithScheme(scheme.Scheme, corev1.SchemeGroupVersion, appsv1.SchemeGroupVersion, rbacv1.SchemeGroupVersion).Path(true, dir).Flatten().Do().Infos()
+		require.NoError(t, err)
+		agents, roles, bindings := 0, 0, 0
+		for _, obj := range objects {
+			switch v := obj.Object.(type) {
+			case *appsv1.DaemonSet:
+				agents++
+				require.Contains(t, v.Spec.Template.Spec.Containers[0].Args, "--count-server-leases=true")
+				require.Contains(t, v.Spec.Template.Spec.Containers[0].Args, "--sync-forever=true")
+				for _, env := range v.Spec.Template.Spec.Containers[0].Env {
+					require.NotEqual(t, "K0S_CONTROLLER_COUNT", env.Name)
+				}
+				require.Equal(t, "konnectivity-agent", v.Spec.Template.Spec.ServiceAccountName)
+			case *rbacv1.Role:
+				roles++
+				require.Equal(t, "kube-system", v.Namespace)
+				require.Equal(t, []rbacv1.PolicyRule{{APIGroups: []string{"coordination.k8s.io"}, Resources: []string{"leases"}, Verbs: []string{"get", "list", "watch"}}}, v.Rules)
+			case *rbacv1.RoleBinding:
+				bindings++
+				require.Equal(t, "kube-system", v.Namespace)
+				require.Equal(t, rbacv1.RoleRef{APIGroup: "rbac.authorization.k8s.io", Kind: "Role", Name: "system:konnectivity-agent"}, v.RoleRef)
+				require.Equal(t, []rbacv1.Subject{{Kind: "ServiceAccount", Name: "konnectivity-agent", Namespace: "kube-system"}}, v.Subjects)
+			}
+		}
+		require.Equal(t, 2, agents)
+		require.Equal(t, 1, roles)
+		require.Equal(t, 1, bindings)
+	}
+}
