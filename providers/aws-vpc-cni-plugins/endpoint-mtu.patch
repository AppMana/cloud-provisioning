diff --git a/plugins/vpc-bridge/network/mtu_windows.go b/plugins/vpc-bridge/network/mtu_windows.go
new file mode 100644
index 0000000..48b7678
--- /dev/null
+++ b/plugins/vpc-bridge/network/mtu_windows.go
@@ -0,0 +1,38 @@
+package network
+
+import (
+	"encoding/json"
+	"fmt"
+
+	"github.com/Microsoft/hcsshim/hcn"
+)
+
+// InterfaceParameters is the HCN endpoint policy introduced in schema 2.4.
+// It configures the workload interface, not the shared ENI or management vNIC.
+type endpointMTUSettings struct {
+	Mtu uint16
+}
+
+func verifyEndpointMTU(endpoint *hcn.HostComputeEndpoint, mtu uint16) error {
+	if mtu == 0 {
+		return nil
+	}
+	count := 0
+	for _, policy := range endpoint.Policies {
+		if policy.Type != hcn.EndpointPolicyType("InterfaceParameters") {
+			continue
+		}
+		count++
+		var settings endpointMTUSettings
+		if err := json.Unmarshal(policy.Settings, &settings); err != nil {
+			return fmt.Errorf("invalid endpoint interface parameters: %w", err)
+		}
+		if settings.Mtu != mtu {
+			return fmt.Errorf("existing endpoint MTU policy %d differs from requested %d", settings.Mtu, mtu)
+		}
+	}
+	if count != 1 {
+		return fmt.Errorf("expected exactly one endpoint MTU policy, found %d", count)
+	}
+	return nil
+}
diff --git a/plugins/vpc-bridge/network/mtu_windows_test.go b/plugins/vpc-bridge/network/mtu_windows_test.go
new file mode 100644
index 0000000..c0a97d8
--- /dev/null
+++ b/plugins/vpc-bridge/network/mtu_windows_test.go
@@ -0,0 +1,35 @@
+package network
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/Microsoft/hcsshim/hcn"
+)
+
+func TestEndpointMTUReadback(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		settings []string
+		mtu      uint16
+		valid    bool
+	}{
+		{"disabled preserves existing", []string{`{"Mtu":1450}`}, 0, true},
+		{"matching policy", []string{`{"Mtu":1370}`}, 1370, true},
+		{"missing policy", nil, 1370, false},
+		{"wrong policy", []string{`{"Mtu":1450}`}, 1370, false},
+		{"missing MTU", []string{`{}`}, 1370, false},
+		{"malformed", []string{`{"Mtu":"1370"}`}, 1370, false},
+		{"ambiguous", []string{`{"Mtu":1370}`, `{"Mtu":1370}`}, 1370, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ep := &hcn.HostComputeEndpoint{}
+			for _, raw := range tc.settings {
+				ep.Policies = append(ep.Policies, hcn.EndpointPolicy{Type: "InterfaceParameters", Settings: json.RawMessage(raw)})
+			}
+			if err := verifyEndpointMTU(ep, tc.mtu); (err == nil) != tc.valid {
+				t.Fatalf("valid=%v error=%v", tc.valid, err)
+			}
+		})
+	}
+}
