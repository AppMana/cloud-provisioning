{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "rke2-canal",
        "namespace": "kube-system"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "k8s-app": "canal"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "k8s-app": "canal"
            }
          },
          "spec": {
            "containers": [
              {
                "image": "rancher/hardened-calico:v3.30.3-build20250909",
                "name": "calico-node"
              },
              {
                "image": "rancher/hardened-flannel:v0.27.3-build20250901",
                "name": "kube-flannel"
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "rke2-canal-config",
        "namespace": "kube-system"
      },
      "data": {
        "net-conf.json": "{\n  \"Network\": \"10.244.0.0/16\",\n  \"Backend\": {\n    \"Type\": \"vxlan\"\n  }\n}\n"
      }
    },
    {
      "apiVersion": "crd.projectcalico.org/v1",
      "kind": "IPPool",
      "metadata": {
        "name": "default-ipv4-ippool"
      },
      "spec": {
        "allowedUses": [
          "Workload",
          "Tunnel"
        ],
        "blockSize": 26,
        "cidr": "192.168.0.0/16",
        "ipipMode": "Never",
        "natOutgoing": true,
        "nodeSelector": "all()",
        "vxlanMode": "Never"
      }
    }
  ]
}
