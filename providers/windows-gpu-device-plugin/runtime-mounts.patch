@@ -0,0 +1,61 @@
+//go:build windows
+
+package plugin
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/tensorworks/directx-device-plugins/plugins/internal/discovery"
+	"go.uber.org/zap"
+	pluginapi "k8s.io/kubelet/pkg/apis/deviceplugin/v1beta1"
+)
+
+// The native Server 2025 GRID 582.53 reproduction fails HCS creation with
+// PCI assignment plus nvcuda.dll, but renders and encodes with PCI alone.
+// Disabling mounts must preserve the selected device and reject unknown IDs.
+func TestRuntimeMountModePreservesDeviceSelection(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "nvcuda_loader64.dll"), []byte("fixture"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	device := &discovery.Device{ID: `PCI\VEN_10DE&DEV_27B8\DEVICE`, LocationPath: "PCIROOT(30)#PCI(0000)#PCI(0000)", DriverStorePath: dir,
+		RuntimeFiles: []*discovery.RuntimeFile{{SourcePath: "nvcuda_loader64.dll", DestinationFilename: "nvcuda.dll"}}}
+	for _, skip := range []bool{false, true} {
+		p := &DevicePlugin{config: &PluginConfig{SkipRuntimeMounts: skip}, currentDevices: []*discovery.Device{device}, logger: zap.NewNop().Sugar()}
+		request := &pluginapi.AllocateRequest{ContainerRequests: []*pluginapi.ContainerAllocateRequest{{DevicesIDs: []string{device.ID + `\0`}}}}
+		response, err := p.Allocate(context.Background(), request)
+		if err != nil {
+			t.Fatal(err)
+		}
+		allocation := response.ContainerResponses[0]
+		if len(allocation.Devices) != 1 || allocation.Devices[0].HostPath != "vpci-location-path://"+device.LocationPath {
+			t.Fatalf("device selection changed: %+v", allocation.Devices)
+		}
+		if skip && len(allocation.Mounts) != 0 {
+			t.Fatal("explicit runtime mounts remain")
+		}
+		if !skip && (len(allocation.Mounts) != 1 || allocation.Mounts[0].ContainerPath != `C:\Windows\System32\nvcuda.dll` || !allocation.Mounts[0].ReadOnly) {
+			t.Fatalf("default mount changed: %+v", allocation.Mounts)
+		}
+		request.ContainerRequests[0].DevicesIDs = []string{`PCI\UNKNOWN\0`}
+		if _, err := p.Allocate(context.Background(), request); err == nil {
+			t.Fatal("unknown device accepted")
+		}
+	}
+}
+
+func TestRuntimeMountConfigOptIn(t *testing.T) {
+	for _, value := range []string{"false", "true"} {
+		t.Setenv("WDDM_DEVICE_PLUGIN_SKIP_RUNTIME_MOUNTS", value)
+		c, err := LoadConfig("wddm", zap.NewNop().Sugar())
+		if err != nil {
+			t.Fatal(err)
+		}
+		if c.SkipRuntimeMounts != (value == "true") {
+			t.Fatalf("env option %q was ignored", value)
+		}
+	}
+}
