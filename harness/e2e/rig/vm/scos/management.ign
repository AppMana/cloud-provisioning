  "systemd": {
    "units": [
      {
        "name": "qemu-guest-agent.service",
        "enabled": true,
        "dropins": [
          {
            "name": "90-cldt-management.conf",
            "contents": "[Unit]\nRequires=cldt-qga-policy.service\nAfter=cldt-qga-policy.service\n[Service]\nExecStart=\nExecStart=/usr/bin/qemu-ga --config=/etc/cldt/qemu-ga.conf\nEnvironment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin\n"
          }
        ]
      },
      {
        "name": "cldt-qga-policy.service",
        "contents": "[Unit]\nDescription=Lab serial management permissions\nBefore=qemu-guest-agent.service\n[Service]\nType=oneshot\nExecStart=/usr/sbin/setsebool virt_qemu_ga_run_unconfined on\nExecStart=/usr/sbin/restorecon -RF /etc/qemu-ga/fsfreeze-hook.d\nRemainAfterExit=yes\nStandardOutput=journal+console\nStandardError=journal+console\n"
      }
    ]
  }
