#cloud-config
{{- template "ssh-authorized-keys" . }}
# k0s-worker join pattern: bring up the tunnel (the shared blocks in
# _shared.tmpl), gate on the cluster's API becoming reachable through
# it, then join as a plain k0s worker using a pre-minted join token.
# This is CAPA's own Machine.spec.bootstrap.dataSecretName content,
# with no bootstrap provider involved (see ../README.md). Every value
# below comes from the join reconciler's render, not from any
# control-plane object.
#
# No balancer here: k0s's nllb gives every worker an envoy on its own
# loopback, so the k0s provider does not implement
# join.NodeLocalBalancer, apiProxyPort renders zero, and the shared
# blocks emit no wg-apiproxy unit. The README's who-balances table is
# that decision's record.
write_files:
{{- template "wg-dialer-files" . }}
{{- template "wg-dialer-unit" . }}
{{- template "wg-apiproxy-unit" . }}
  - path: /etc/k0s/join-token
    permissions: '0600'
    content: |
      {{ .joinToken }}
runcmd:
{{- template "dialer-install" . }}
  # Gate on the API's TCP port rather than ICMP: minimal cloud images
  # may ship no ping at all, and cloud firewalls routinely drop ICMP
  # while allowing the API port. curl is already a hard dependency of
  # this pattern. Any HTTP response, including 401/403, proves
  # reachability, so no -f here.
  - until curl -sk --max-time 3 -o /dev/null https://{{ .apiEndpoint }}/livez; do sleep 2; done
  # The cluster's CNI configuration chains standard plugins. For
  # example, 10-calico.conflist chains calico, calico-ipam, k8s,
  # portmap and bandwidth in that order. Calico's install-cni ships
  # calico-ipam, flannel, host-local, loopback, portmap and tuning, but
  # not bandwidth, and k0s bundles only containerd, kubelet, iptables
  # and runc. On existing nodes bandwidth was placed there by whatever
  # provisioned them; a freshly provisioned node has no way to get it,
  # and every pod sandbox then fails with 'failed to find plugin
  # "bandwidth" in path [/opt/cni/bin]'.
  #
  # This fills gaps only: a plugin Calico already installed is left
  # alone, so it does not downgrade calico-ipam or portmap to the
  # upstream build underneath a running CNI.
  {{- if or .cniPluginsURLArm64 .cniPluginsURLAmd64 }}
  - |
    set -e
    case "$(uname -m)" in
      aarch64|arm64) url='{{ .cniPluginsURLArm64 }}'; sha='{{ .cniPluginsSHA256Arm64 }}' ;;
      x86_64|amd64)  url='{{ .cniPluginsURLAmd64 }}'; sha='{{ .cniPluginsSHA256Amd64 }}' ;;
      *) url=''; sha='' ;;
    esac
    [ -n "$url" ] || exit 0
    mkdir -p /opt/cni/bin /tmp/cni-plugins
    curl -fsSL -o /tmp/cni-plugins.tgz "$url"
    echo "$sha  /tmp/cni-plugins.tgz" | sha256sum -c -
    tar -C /tmp/cni-plugins -xzf /tmp/cni-plugins.tgz
    for f in /tmp/cni-plugins/*; do
      [ -e "/opt/cni/bin/$(basename "$f")" ] || cp -a "$f" /opt/cni/bin/
    done
    rm -rf /tmp/cni-plugins /tmp/cni-plugins.tgz
  {{- end }}
  - curl -sSLf https://get.k0s.sh | K0S_VERSION={{ .k0sVersion }} sh
  # k0s resolves node IPs by looking up the instance's own hostname
  # rather than inspecting interfaces. On AWS that hostname maps only
  # to the private IPv4 in /etc/hosts, so a dual-stack cluster's
  # kubelet fails to start ("IP address lookup didn't return addresses
  # for both families") even when the interface has a real IPv6 GUA.
  # --node-ip bypasses that lookup with addresses fetched directly from
  # instance metadata instead. (IMDSv2, AWS-specific: a different
  # infrastructure provider's variant of this pattern would fetch its
  # own metadata service here instead.)
  - |
    IMDS_TOKEN=$(curl -sSf -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    NODE_IPV4=$(curl -sSf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)
    NODE_IPV6=$(curl -sSf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/ipv6 || true)
    NODE_IP_ARG="--node-ip=$NODE_IPV4"
    [ -n "$NODE_IPV6" ] && NODE_IP_ARG="--node-ip=$NODE_IPV4,$NODE_IPV6"
    k0s install worker --token-file /etc/k0s/join-token --kubelet-extra-args="{{ .kubeletExtraArgs }} $NODE_IP_ARG"
  - k0s start
{{- template "bootstrap-sentinel" . }}
