diff --git a/pkg/component/worker/static_pods_listener_test.go b/pkg/component/worker/static_pods_listener_test.go
new file mode 100644
index 00000000..42ed2166
--- /dev/null
+++ b/pkg/component/worker/static_pods_listener_test.go
@@ -0,0 +1,137 @@
+// SPDX-FileCopyrightText: 2026 k0s authors
+// SPDX-License-Identifier: Apache-2.0
+
+package worker
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func listenerTestServer(t *testing.T, runDir string) *staticPods {
+	t.Helper()
+	server := NewStaticPods(runDir).(*staticPods)
+	require.NoError(t, server.Init(t.Context()))
+	t.Cleanup(func() {
+		if server.peekLifecycle() == staticPodsStarted {
+			require.NoError(t, server.Stop())
+		}
+	})
+	return server
+}
+
+func recordKubeletManifestURL(t *testing.T, runDir, address string) {
+	t.Helper()
+	directory := filepath.Join(runDir, "kubelet")
+	require.NoError(t, os.MkdirAll(directory, 0700))
+	config, err := json.Marshal(map[string]string{"apiVersion": "kubelet.config.k8s.io/v1beta1", "kind": "KubeletConfiguration", "staticPodURL": address})
+	require.NoError(t, err)
+	require.NoError(t, os.WriteFile(filepath.Join(directory, "config.yaml"), config, 0600))
+}
+
+func TestStaticPodsPreservesManifestURL(t *testing.T) {
+	runDir := t.TempDir()
+	first := listenerTestServer(t, runDir)
+	require.NoError(t, first.Start(t.Context()))
+	pod, err := first.ClaimStaticPod("default", "dummy-test")
+	require.NoError(t, err)
+	require.NoError(t, pod.SetManifest(dummyPod))
+	address, err := first.ManifestURL()
+	require.NoError(t, err)
+	original := fetchStaticManifest(t, address.String())
+	recordKubeletManifestURL(t, runDir, address.String())
+	require.NoError(t, first.Stop())
+	second := listenerTestServer(t, runDir)
+	require.NoError(t, second.Start(t.Context()))
+	t.Cleanup(func() { require.NoError(t, second.Stop()) })
+	actual, err := second.ManifestURL()
+	require.NoError(t, err)
+	require.Equal(t, address.String(), actual.String())
+	pod, err = second.ClaimStaticPod("default", "dummy-test")
+	require.NoError(t, err)
+	require.NoError(t, pod.SetManifest(dummyPod))
+	body := fetchStaticManifest(t, actual.String())
+	require.Equal(t, original, body, "unchanged manifest and URL preserve kubelet's existing identity inputs")
+}
+
+func TestStaticPodsOccupiedPreviousListener(t *testing.T) {
+	runDir := t.TempDir()
+	first := listenerTestServer(t, runDir)
+	require.NoError(t, first.Start(t.Context()))
+	address, err := first.ManifestURL()
+	require.NoError(t, err)
+	recordKubeletManifestURL(t, runDir, address.String())
+	second := listenerTestServer(t, runDir)
+	err = second.Start(t.Context())
+	if err == nil {
+		require.NoError(t, second.Stop())
+	}
+	require.Error(t, err, "an occupied previous address must not silently change static-pod identities")
+	require.NoError(t, first.Stop())
+	require.NoError(t, second.Start(t.Context()), "a failed bind must leave the component retryable")
+	t.Cleanup(func() { require.NoError(t, second.Stop()) })
+	actual, err := second.ManifestURL()
+	require.NoError(t, err)
+	require.Equal(t, address.String(), actual.String())
+}
+
+func TestStaticPodsRejectsInvalidPreviousURL(t *testing.T) {
+	for _, address := range []string{"http://0.0.0.0:12345/manifests", "http://127.0.0.2:12345/manifests", "https://127.0.0.1:12345/manifests", "http://user:password@127.0.0.1:12345/manifests", "http://127.0.0.1:12345/other", "http://127.0.0.1:0/manifests", "http://127.0.0.1:65536/manifests", "http://127.0.0.1/manifests", "http://127.0.0.1:12345/manifests?x=y", "http://127.0.0.1:12345/manifests#fragment"} {
+		t.Run(address, func(t *testing.T) {
+			runDir := t.TempDir()
+			recordKubeletManifestURL(t, runDir, address)
+			server := listenerTestServer(t, runDir)
+			err := server.Start(t.Context())
+			if err == nil {
+				require.NoError(t, server.Stop())
+			}
+			require.Error(t, err)
+		})
+	}
+}
+
+func fetchStaticManifest(t *testing.T, address string) []byte {
+	t.Helper()
+	client := &http.Client{Timeout: 5 * time.Second}
+	response, err := client.Get(address)
+	require.NoError(t, err)
+	defer response.Body.Close()
+	require.Equal(t, http.StatusOK, response.StatusCode)
+	body, err := io.ReadAll(response.Body)
+	require.NoError(t, err)
+	return body
+}
+
+func TestStaticPodsPreviousConfigFailures(t *testing.T) {
+	for _, data := range []string{"", "null", "[broken", "kind: Secret\nstaticPodURL: http://127.0.0.1:12345/manifests\n"} {
+		t.Run(data, func(t *testing.T) {
+			runDir := t.TempDir()
+			recordKubeletManifestURL(t, runDir, "")
+			require.NoError(t, os.WriteFile(filepath.Join(runDir, "kubelet", "config.yaml"), []byte(data), 0600))
+			server := listenerTestServer(t, runDir)
+			require.Error(t, server.Start(t.Context()))
+		})
+	}
+	t.Run("unreadable", func(t *testing.T) {
+		runDir := t.TempDir()
+		require.NoError(t, os.MkdirAll(filepath.Join(runDir, "kubelet", "config.yaml"), 0700))
+		require.Error(t, listenerTestServer(t, runDir).Start(t.Context()))
+	})
+	t.Run("previously-disabled", func(t *testing.T) {
+		runDir := t.TempDir()
+		recordKubeletManifestURL(t, runDir, "")
+		server := listenerTestServer(t, runDir)
+		require.NoError(t, server.Start(t.Context()))
+		address, err := server.ManifestURL()
+		require.NoError(t, err)
+		require.Equal(t, "127.0.0.1", address.Hostname())
+		require.NotEmpty(t, address.Port())
+	})
+}
