#cloud-config
{{- template "ssh-authorized-keys" . }}
# kubeadm-worker join pattern: bring up the tunnel and the node-local
# API balancer (the shared blocks in _shared.tmpl), gate on the API
# through them, then join as a plain kubeadm worker using a pre-minted
# bootstrap token + CA-hash pin. Set directly as
# Machine.spec.bootstrap.dataSecretName content, with no bootstrap
# provider; the other patterns are the same contract.
#
# Only write_files and runcmd belong here: CAPD (this pattern's first
# consumer) interprets cloud-config with its own parser, and any other
# top-level module lands in its "unknown" handler, which parses the
# block as JSON and fails on plain YAML. See
# cluster-api/test/infrastructure/docker/internal/provisioning/
# cloudinit/{adapter,unknown}.go.
#
# kubeadm is the one distribution that ships no node-local balancing
# of its own (join-patterns/README.md tracks who balances where), so
# its provider declares the need (join.NodeLocalBalancer) and the
# reconciler sets apiProxyPort; the shared blocks then render the
# wg-apiproxy unit, a lifecycle deliberately separate from the
# dialer's, because kubelet depends on this path before any pod can
# run and must not lose it to the dialer's restarts.
write_files:
{{- template "wg-dialer-files" . }}
{{- template "wg-dialer-unit" . }}
{{- template "wg-apiproxy-unit" . }}
  # kubelet extra args (role label + internet-facing taint) via the
  # environment file kubeadm's kubelet drop-in already sources. Both
  # families' paths, because they differ and only one is read:
  # /etc/default/kubelet on Debian-family, /etc/sysconfig/kubelet on
  # RPM-family (RHEL, Fedora, Amazon Linux). Writing one path silently
  # drops the args on the other family: the node joins, looks healthy,
  # and is missing exactly the label and taint that make it a cloud
  # worker. This keeps the generic kubeletExtraArgs contract without
  # translating it into JoinConfiguration structure.
  - path: /etc/default/kubelet
    permissions: '0644'
    content: |
      KUBELET_EXTRA_ARGS={{ .kubeletExtraArgs }}{{ if .providerID }} --provider-id={{ .providerID }}{{ end }}
  - path: /etc/sysconfig/kubelet
    permissions: '0644'
    content: |
      KUBELET_EXTRA_ARGS={{ .kubeletExtraArgs }}{{ if .providerID }} --provider-id={{ .providerID }}{{ end }}
runcmd:
{{- template "dialer-install" . }}
  # Which of its own addresses this node registers with.
  #
  # Appended to the same environment files, and before the join,
  # because kubeadm starts the kubelet and the kubelet reads them
  # then. Without it the node chooses for itself and chooses wrong
  # wherever it has more than one address: measured on a machine with
  # an out-of-band interface, the kubelet registered 10.0.0.15 — the
  # address every machine in that fleet shares — while the provider
  # had published the other one, so nothing ever bound the Machine to
  # the Node.
  - |
    set -e
{{- template "node-ip-arg" . }}
{{- if index . "providerIdentityScript" }}
    for f in /etc/default/kubelet /etc/sysconfig/kubelet; do
      [ ! -f "$f" ] || sed -i "s|^KUBELET_EXTRA_ARGS=.*|& $PROVIDER_ID_ARG|" "$f"
    done
{{- end }}
    if [ -n "$NODE_IP_ARG" ]; then
      for f in /etc/default/kubelet /etc/sysconfig/kubelet; do
        if [ -f "$f" ]; then
          sed -i "s|^KUBELET_EXTRA_ARGS=.*|& $NODE_IP_ARG|" "$f"
        fi
      done
    fi
  # Gate on the API becoming reachable through the tunnel before
  # joining. TCP rather than ICMP: minimal cloud images ship no ping at
  # all (kindest/node: exit 127) and cloud firewalls routinely drop
  # ICMP while allowing the API port. curl is already a hard dependency
  # of this pattern. Any HTTP response, including 401/403, proves
  # reachability, so no -f here.
  #
  # With a balancer port set, both the gate and the join dial the
  # node's own loopback, which wg-apiproxy serves: one probe proves the
  # tunnel, the balancer, and a live control plane, and kubelet.conf
  # points at the loopback forever after, so the node depends on the
  # set of control planes rather than the one that minted its token.
  # That requires the loopback address in the API servers' certificate
  # SANs (kubeadm: certSANs). Port zero is for a kubeadm cluster that
  # terminates its API behind an external load balancer: the join
  # dials the endpoint directly, kubelet inheriting whatever that
  # balancer does about member deaths.
{{- if .apiProxyPort }}
  - until curl -sk --max-time 3 -o /dev/null https://127.0.0.1:{{ .apiProxyPort }}/livez; do sleep 2; done
  - |
    kubeadm join 127.0.0.1:{{ .apiProxyPort }} \
      --token {{ .joinToken }} \
      --discovery-token-ca-cert-hash {{ .caCertHash }} \
      --node-name "$(hostname)"
{{- else }}
  - until curl -sk --max-time 3 -o /dev/null https://{{ .apiEndpoint }}/livez; do sleep 2; done
  - |
    kubeadm join {{ .joinEndpoint }} \
      --token {{ .joinToken }} \
      --discovery-token-ca-cert-hash {{ .caCertHash }} \
      --node-name "$(hostname)"
{{- end }}
{{- template "bootstrap-sentinel" . }}
