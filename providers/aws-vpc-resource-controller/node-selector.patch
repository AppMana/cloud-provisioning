+func TestNodeSelectorWindowsIPAM(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		selectedLabel string
+		want          bool
+	}{
+		{"matching cloud worker", "aws-vpc", true},
+		{"site worker", "calico-site", false},
+		{"unlabelled worker", "", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctrl := gomock.NewController(t)
+			defer ctrl.Finish()
+			mock := NewMock(ctrl, map[string]node.Node{})
+			mock.Manager.nodeSelector = labels.SelectorFromSet(labels.Set{"network.example/cni": "aws-vpc"})
+			candidate := v1Node.DeepCopy()
+			candidate.Labels = map[string]string{config.NodeLabelOS: config.OSWindows}
+			if tc.selectedLabel != "" {
+				candidate.Labels["network.example/cni"] = tc.selectedLabel
+			}
+			if tc.want {
+				mock.MockConditions.EXPECT().IsWindowsIPAMEnabled().Return(true)
+			}
+			got, err := mock.Manager.isSelectedForManagement(candidate)
+			assert.NoError(t, err)
+			assert.Equal(t, tc.want, got)
+		})
+	}
+}
