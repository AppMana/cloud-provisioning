{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:${AWS_REGION}:${AWS_ACCOUNT_ID}:security-group/${SECURITY_GROUP_ID}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "ec2:ResourceTag/${OWNER_TAG}": "${OWNER_VALUE}"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:AuthorizeSecurityGroupIngress",
      "Resource": "arn:aws:ec2:${AWS_REGION}:${AWS_ACCOUNT_ID}:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "aws:RequestTag/${OWNER_TAG}": "${OWNER_VALUE}"
        },
        "Null": {
          "aws:RequestTag/cloud-provisioning.appmana.com/ingress-owner": "false"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:${AWS_REGION}:${AWS_ACCOUNT_ID}:security-group-rule/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${AWS_REGION}",
          "ec2:CreateAction": "AuthorizeSecurityGroupIngress",
          "aws:RequestTag/${OWNER_TAG}": "${OWNER_VALUE}"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "${OWNER_TAG}",
            "cloud-provisioning.appmana.com/ingress-owner"
          ]
        }
      }
    }
  ]
}
