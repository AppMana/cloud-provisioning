diff --git a/plugins/vpc-bridge/network/test-forwarding.ps1 b/plugins/vpc-bridge/network/test-forwarding.ps1
new file mode 100644
index 0000000..464f3fb
--- /dev/null
+++ b/plugins/vpc-bridge/network/test-forwarding.ps1
@@ -0,0 +1,40 @@
+param([string]$Case = 'enable')
+$ErrorActionPreference = 'Stop'
+$scope = @{ id='net-id'; name='vpcbr020000000001'; ip='172.29.0.18'; mac='02:00:00:00:00:01' }
+$global:sets = 0
+$global:reads = 0
+$global:forwarding = if ($Case -eq 'idempotent') { 'Enabled' } else { 'Disabled' }
+function Get-HnsNetwork {
+    $id = if ($Case -eq 'foreign-network') {'other-id'} else {'net-id'}
+    $ip = if ($Case -eq 'foreign-ip') {'172.29.0.19'} else {'172.29.0.18'}
+    $type = if ($Case -eq 'foreign-type') {'Overlay'} else {'L2Bridge'}
+    [pscustomobject]@{ ID=$id; Name='vpcbr020000000001'; Type=$type; ManagementIP=$ip; NetworkAdapterName='Ethernet' }
+}
+function Get-NetAdapter {
+    param([switch]$IncludeHidden)
+    [pscustomobject]@{Name='Ethernet'; InterfaceIndex=7; InterfaceGuid='physical'; MacAddress='02-00-00-00-00-01'; Virtual=$false; HardwareInterface=$true}
+    $mac = if ($Case -eq 'foreign-mac') {'02-00-00-00-00-02'} else {'02-00-00-00-00-01'}
+    $guid = if ($Case -eq 'replaced' -and $global:sets -gt 0) {'replacement'} else {'owned'}
+    [pscustomobject]@{Name='Host vNIC'; InterfaceIndex=9; InterfaceGuid=$guid; MacAddress=$mac; Virtual=$true; HardwareInterface=($Case -eq 'physical-target')}
+    [pscustomobject]@{Name='Tunnel'; InterfaceIndex=11; InterfaceGuid='tunnel'; MacAddress=''; Virtual=$true; HardwareInterface=$false}
+}
+function Get-NetIPAddress {
+    param($AddressFamily)
+    [pscustomobject]@{InterfaceIndex=9; IPAddress='172.29.0.18'; AddressState='Preferred'}
+    if ($Case -eq 'ambiguous-ip') { [pscustomobject]@{InterfaceIndex=10; IPAddress='172.29.0.18'; AddressState='Preferred'} }
+}
+function Get-NetIPInterface {
+    param($InterfaceIndex,$AddressFamily,$PolicyStore)
+    if ($InterfaceIndex -ne 9 -or $AddressFamily -ne 'IPv4' -or $PolicyStore -ne 'ActiveStore') { throw 'Unscoped interface read' }
+    $global:reads++
+    [pscustomobject]@{Forwarding=$global:forwarding}
+}
+function Set-NetIPInterface {
+    param($InterfaceIndex,$AddressFamily,$PolicyStore,$Forwarding)
+    if ($InterfaceIndex -ne 9 -or $AddressFamily -ne 'IPv4' -or $PolicyStore -ne 'ActiveStore' -or $Forwarding -ne 'Enabled') { throw 'Unscoped mutation' }
+    $global:sets++
+    if ($Case -ne 'readback-failure') { $global:forwarding='Enabled' }
+}
+# Export counters even if the production script exits on a rejection.
+try { & "$PSScriptRoot/forwarding_windows.ps1"; if ($LASTEXITCODE) { exit $LASTEXITCODE } }
+finally { [Console]::Out.WriteLine((@{sets=$global:sets;reads=$global:reads} | ConvertTo-Json -Compress)) }
