diff --git a/pkg/component/worker/nllb/metadata.go b/pkg/component/worker/nllb/metadata.go
new file mode 100644
index 00000000..cde449c3
--- /dev/null
+++ b/pkg/component/worker/nllb/metadata.go
@@ -0,0 +1,16 @@
+// SPDX-FileCopyrightText: 2026 k0s authors
+// SPDX-License-Identifier: Apache-2.0
+
+package nllb
+
+import "github.com/k0sproject/k0s/pkg/applier"
+
+func staticPodLabels() applier.Meta {
+	labels := applier.CommonLabels("nllb")
+	// Kubelet hashes the complete static Pod, including labels. The k0s
+	// build version does not identify the proxy image and must not replace
+	// an unchanged load balancer when only the supervising binary changes.
+	// The actual proxy image remains part of the PodSpec and its identity.
+	delete(labels, "app.kubernetes.io/version")
+	return labels
+}
