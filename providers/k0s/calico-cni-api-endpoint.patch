 func (c *Calico) getConfig(clusterConfig *v1beta1.ClusterConfig) (*calicoClusterConfig, error) {
+	apiServer := c.nodeConfig.APIServer
+	nllb := clusterConfig.Spec.Network.NodeLocalLoadBalancing
+	if nllb.IsEnabled() {
+		var port int32
+		switch nllb.Type {
+		case v1beta1.NllbTypeEnvoyProxy:
+			if nllb.EnvoyProxy == nil {
+				return nil, fmt.Errorf("Calico CNI requires configured Envoy API endpoint")
+			}
+			port = nllb.EnvoyProxy.APIServerBindPort
+		case v1beta1.NllbTypeTraefik:
+			if nllb.Traefik == nil {
+				return nil, fmt.Errorf("Calico CNI requires configured Traefik API endpoint")
+			}
+			port = nllb.Traefik.APIServerBindPort
+		default:
+			return nil, fmt.Errorf("unsupported Calico CNI node-local load balancer %q", nllb.Type)
+		}
+		if port < 1 || port > 65535 {
+			return nil, fmt.Errorf("invalid Calico CNI API port %d", port)
+		}
+		var err error
+		apiServer, err = k0snet.NewHostPort("localhost", uint16(port))
+		if err != nil {
+			return nil, err
+		}
+	}
 	ipv6AutoDetectionMethod := clusterConfig.Spec.Network.Calico.IPAutodetectionMethod
 	if clusterConfig.Spec.Network.Calico.IPv6AutodetectionMethod != "" {
 		ipv6AutoDetectionMethod = clusterConfig.Spec.Network.Calico.IPv6AutodetectionMethod
