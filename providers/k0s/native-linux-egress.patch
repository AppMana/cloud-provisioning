 	HostNetwork     bool
 }
 
+// Keep node-address agents on both operating systems for kubelet access.
+// Linux agents separately carry unmatched destinations such as Service IPs,
+// which Windows host-network agents cannot reach.
+type konnectivityAgentVariant struct {
+	konnectivityAgentConfig
+	Name         string
+	Identifiers  string
+	AgentID      string
+	HealthPort   int
+	DefaultRoute bool
+}
+
+func (cfg konnectivityAgentConfig) Agents() []konnectivityAgentVariant {
+	return []konnectivityAgentVariant{
+		{konnectivityAgentConfig: cfg, Name: "konnectivity-agent", Identifiers: "host=$(NODE_IP)", AgentID: "$(NODE_IP)", HealthPort: 8093},
+		{konnectivityAgentConfig: cfg, Name: "konnectivity-agent-default-route-linux", Identifiers: "default-route=true", AgentID: "default-route-linux-$(NODE_IP)", HealthPort: 18095, DefaultRoute: true},
+	}
+}
