+func (s *staticPods) previousListenerAddress() (string, error) {
+	data, err := os.ReadFile(s.kubeletConfigPath)
+	if errors.Is(err, os.ErrNotExist) {
+		return "127.0.0.1:", nil
+	}
+	if err != nil {
+		return "", fmt.Errorf("read previous kubelet configuration: %w", err)
+	}
+	// Read only the generated URL; the rest of the kubelet configuration is
+	// owned and validated by the kubelet component.
+	var config struct {
+		Kind         string `json:"kind"`
+		StaticPodURL string `json:"staticPodURL"`
+	}
+	if err := yaml.Unmarshal(data, &config); err != nil {
+		return "", fmt.Errorf("decode previous kubelet configuration: %w", err)
+	}
+	if config.Kind != "KubeletConfiguration" {
+		return "", errors.New("previous kubelet configuration has an unexpected kind")
+	}
+	if config.StaticPodURL == "" {
+		return "127.0.0.1:", nil // NLLB was not enabled in the previous config.
+	}
+	u, err := url.Parse(config.StaticPodURL)
+	if err != nil {
+		return "", errors.New("invalid staticPodURL in previous kubelet configuration")
+	}
+	port, err := strconv.Atoi(u.Port())
+	address := net.JoinHostPort("127.0.0.1", strconv.Itoa(port))
+	if err != nil || port < 1 || port > 65535 ||
+		config.StaticPodURL != "http://"+address+"/manifests" {
+		return "", errors.New("unsupported staticPodURL in previous kubelet configuration")
+	}
+	return address, nil
+}
