diff --git a/plugins/vpc-bridge/network/forwarding_windows.go b/plugins/vpc-bridge/network/forwarding_windows.go
new file mode 100644
index 0000000..aa886a3
--- /dev/null
+++ b/plugins/vpc-bridge/network/forwarding_windows.go
@@ -0,0 +1,52 @@
+package network
+
+import (
+	"context"
+	_ "embed"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"os/exec"
+	"time"
+	"unicode/utf16"
+)
+
+//go:embed forwarding_windows.ps1
+var hostForwardingScript string
+
+// enableHostRouteForwarding runs only for explicit host routes. HNS owns the
+// management vNIC lifecycle; reconcile its active IPv4 forwarding before ADD
+// creates or reuses an endpoint. Do not disable forwarding on individual DEL:
+// other endpoints can still depend on the shared network.
+func (nb *BridgeBuilder) enableHostRouteForwarding(nw *Network) error {
+	if len(nw.HostRouteCIDRs) == 0 {
+		return nil
+	}
+	if nw.SharedENI == nil || len(nw.ENIIPAddresses) == 0 || nw.NetworkID == "" {
+		return fmt.Errorf("host routes require an identified HNS network and ENI")
+	}
+	scope, err := json.Marshal(map[string]string{
+		"id": nw.NetworkID, "name": nb.generateHNSNetworkName(nw),
+		"ip": nw.ENIIPAddresses[0].IP.String(), "mac": nw.SharedENI.GetMACAddress().String(),
+	})
+	if err != nil {
+		return err
+	}
+	script := "$scope = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" + base64.StdEncoding.EncodeToString(scope) + "')) | ConvertFrom-Json\n" + hostForwardingScript
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	output, err := exec.CommandContext(ctx, "powershell.exe", "-NoProfile", "-NonInteractive", "-EncodedCommand", encodePowerShell(script)).CombinedOutput()
+	if err != nil {
+		return fmt.Errorf("configure HNS host forwarding: %w: %s", err, output)
+	}
+	return nil
+}
+
+func encodePowerShell(script string) string {
+	units := utf16.Encode([]rune(script))
+	bytes := make([]byte, 2*len(units))
+	for i, unit := range units {
+		bytes[2*i], bytes[2*i+1] = byte(unit), byte(unit>>8)
+	}
+	return base64.StdEncoding.EncodeToString(bytes)
+}
diff --git a/plugins/vpc-bridge/network/forwarding_windows.ps1 b/plugins/vpc-bridge/network/forwarding_windows.ps1
new file mode 100644
index 0000000..2510e99
--- /dev/null
+++ b/plugins/vpc-bridge/network/forwarding_windows.ps1
@@ -0,0 +1,48 @@
+$ErrorActionPreference = 'Stop'
+Set-StrictMode -Version Latest
+try {
+    function Assert-Network {
+        $networks = @(Get-HnsNetwork | Where-Object { $_.ID -eq $scope.id })
+        if ($networks.Count -ne 1) { throw 'HNS network identity missing or ambiguous' }
+        $network = $networks[0]
+        if ($network.Name -ne $scope.name -or $network.Type -ne 'L2Bridge' -or
+            $network.ManagementIP -ne $scope.ip) { throw 'HNS network ownership mismatch' }
+        return $network
+    }
+    function Normalize-Mac($value) { return ($value -replace '[:-]', '').ToLowerInvariant() }
+    $network = Assert-Network
+    $mac = Normalize-Mac $scope.mac
+    if ($mac -notmatch '^[0-9a-f]{12}$') { throw 'Invalid ENI MAC' }
+    $physical = @(Get-NetAdapter -IncludeHidden | Where-Object {
+        $_.Name -eq $network.NetworkAdapterName -and $_.HardwareInterface -and
+        (Normalize-Mac $_.MacAddress) -eq $mac
+    })
+    if ($physical.Count -ne 1) { throw 'HNS physical ENI ownership mismatch' }
+    function Get-OwnedHostAdapter {
+        $addresses = @(Get-NetIPAddress -AddressFamily IPv4 | Where-Object {
+            $_.IPAddress -eq $scope.ip -and $_.AddressState -eq 'Preferred'
+        })
+        if ($addresses.Count -ne 1) { throw 'HNS management address missing or ambiguous' }
+        $adapters = @(Get-NetAdapter -IncludeHidden | Where-Object {
+            $_.InterfaceIndex -eq $addresses[0].InterfaceIndex -and
+            $_.Virtual -and -not $_.HardwareInterface -and
+            (Normalize-Mac $_.MacAddress) -eq $mac
+        })
+        if ($adapters.Count -ne 1) { throw 'HNS host vNIC ownership mismatch' }
+        return $adapters[0]
+    }
+    $adapter = Get-OwnedHostAdapter
+    $before = @(Get-NetIPInterface -InterfaceIndex $adapter.InterfaceIndex -AddressFamily IPv4 -PolicyStore ActiveStore)
+    if ($before.Count -ne 1) { throw 'Host IPv4 interface missing or ambiguous' }
+    if ($before[0].Forwarding -ne 'Enabled') {
+        Set-NetIPInterface -InterfaceIndex $adapter.InterfaceIndex -AddressFamily IPv4 -PolicyStore ActiveStore -Forwarding Enabled
+    }
+    $null = Assert-Network
+    $afterAdapter = Get-OwnedHostAdapter
+    if ($afterAdapter.InterfaceGuid -ne $adapter.InterfaceGuid) { throw 'HNS host vNIC changed during forwarding setup' }
+    $after = @(Get-NetIPInterface -InterfaceIndex $adapter.InterfaceIndex -AddressFamily IPv4 -PolicyStore ActiveStore)
+    if ($after.Count -ne 1 -or $after[0].Forwarding -ne 'Enabled') { throw 'Host IPv4 forwarding verification failed' }
+} catch {
+    [Console]::Error.WriteLine($_.Exception.Message)
+    exit 1
+}
diff --git a/plugins/vpc-bridge/network/forwarding_windows_test.go b/plugins/vpc-bridge/network/forwarding_windows_test.go
