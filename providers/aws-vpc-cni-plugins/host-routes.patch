 	IPAddresses      []string `json:"ipAddresses"`
@@ -149,6 +151,38 @@ func New(args *cniSkel.CmdArgs, isAddCmd bool) (*NetConfig, error) {
 		}
 	}
 
+	// Explicit off-VPC IPv4 destinations routed through the Windows host.
+	// Never divert the ENI subnet, the default route, or non-unicast traffic.
+	if len(config.HostRouteCIDRs) > 0 && len(netConfig.ENIIPAddresses) == 0 {
+		return nil, fmt.Errorf("host routes require explicit ENI IP addresses for subnet validation")
+	}
+	seenHostRoutes := make(map[string]bool)
+	for _, value := range config.HostRouteCIDRs {
+		ip, prefix, err := net.ParseCIDR(value)
+		if err != nil {
+			return nil, fmt.Errorf("invalid host route CIDR %q", value)
+		}
+		ones, bits := prefix.Mask.Size()
+		if bits != 32 || ones == 0 || !ip.Equal(prefix.IP) || !ip.IsGlobalUnicast() || ip.IsLoopback() || ip.IsLinkLocalUnicast() {
+			return nil, fmt.Errorf("host route must be a canonical non-default unicast IPv4 prefix: %q", value)
+		}
+		for _, reserved := range []string{"0.0.0.0/8", "127.0.0.0/8", "169.254.0.0/16", "224.0.0.0/3"} {
+			_, blocked, _ := net.ParseCIDR(reserved)
+			if prefix.Contains(blocked.IP) || blocked.Contains(prefix.IP) {
+				return nil, fmt.Errorf("host route overlaps non-unicast or local scope: %q", value)
+			}
+		}
+		for _, eni := range netConfig.ENIIPAddresses {
+			if prefix.Contains(eni.IP) || eni.Contains(prefix.IP) {
+				return nil, fmt.Errorf("host route overlaps ENI subnet: %q", value)
+			}
+		}
+		if !seenHostRoutes[prefix.String()] {
+			netConfig.HostRouteCIDRs = append(netConfig.HostRouteCIDRs, *prefix)
+			seenHostRoutes[prefix.String()] = true
+		}
+	}
+
 	// Parse the bridge type.
 	if config.BridgeType != BridgeTypeL2 && config.BridgeType != BridgeTypeL3 {
 		return nil, fmt.Errorf("invalid BridgeType %s", config.BridgeType)
