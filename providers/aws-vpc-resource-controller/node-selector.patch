+func TestNodeSelectorExcludedNodeDoesNotCreateResources(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+	mock := NewMock(ctrl, map[string]node.Node{})
+	mock.Manager.nodeSelector = labels.SelectorFromSet(labels.Set{"network.example/cni": "aws-vpc"})
+	candidate := v1Node.DeepCopy()
+	candidate.Labels = map[string]string{config.NodeLabelOS: config.OSWindows}
+	mock.MockK8sAPI.EXPECT().GetNode(nodeName).Return(candidate, nil)
+	assert.NoError(t, mock.Manager.AddNode(nodeName))
+	cached, found := mock.Manager.GetNode(nodeName)
+	assert.True(t, found)
+	assert.False(t, cached.IsManaged())
+	// An excluded node must not query/create a CNINode, submit allocation work,
+	// or invoke an AWS client. The mocks intentionally permit none of those.
+}
