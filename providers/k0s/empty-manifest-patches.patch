+func TestTemplateWriter_OptionalCalicoManifestsWithPatches(t *testing.T) {
+	for _, name := range []string{"ConfigMap/calico-config.yaml", "DaemonSet/calico-node-windows.yaml", "IPAMConfig/default.yaml"} {
+		t.Run(name, func(t *testing.T) {
+			contents, err := fs.ReadFile(static.CalicoManifests, name)
+			require.NoError(t, err)
+			tw := templatewriter.TemplateWriter{
+				Name: name, Template: string(contents),
+				Data: map[string]any{"IncludeWindows": false, "Mode": "bird"},
+				Patches: v1beta1.Patches{{
+					Target: v1beta1.PatchTarget{Kind: "DaemonSet", Name: "calico-node"},
+					Patch:  v1beta1.PatchSpec{Type: v1beta1.MergePatchType, Content: `{"spec":{"template":{"spec":{"nodeSelector":{"kubernetes.io/os":"linux"}}}}}`},
+				}},
+			}
+			var out bytes.Buffer
+			require.NoError(t, tw.WriteToBuffer(&out))
+			value, err := yaml.YAMLToJSON(out.Bytes())
+			require.NoError(t, err)
+			require.Equal(t, "null", string(value), "disabled templates must not create resources")
+		})
+	}
+}
