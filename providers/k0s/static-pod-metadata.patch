@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: 2026 k0s authors
+// SPDX-License-Identifier: Apache-2.0
+
+package nllb
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"testing"
+
+	"github.com/k0sproject/k0s/pkg/apis/k0s/v1beta1"
+	"github.com/k0sproject/k0s/pkg/applier"
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+)
+
+func TestStaticPodBuildMetadata(t *testing.T) {
+	for _, backend := range []struct {
+		name     string
+		manifest func(string) *corev1.Pod
+	}{
+		{"envoy", func(version string) *corev1.Pod {
+			pod := makePodManifest(&envoyParams{apiServerBindPort: 7443}, &envoyPodParams{
+				image: v1beta1.ImageSpec{Image: "example.invalid/envoy", Version: version},
+			})
+			return &pod
+		}},
+		{"traefik", func(version string) *corev1.Pod {
+			return makeTraefikPodManifest(&traefikPodParams{
+				image: v1beta1.ImageSpec{Image: "example.invalid/traefik", Version: version},
+			}, &traefikInstallConfig{apiServerBindPort: 7443})
+		}},
+	} {
+		t.Run(backend.name, func(t *testing.T) {
+			pod := backend.manifest("v1")
+			require.NotContains(t, pod.Labels, "app.kubernetes.io/version")
+			require.Equal(t, "nllb", pod.Labels["app.kubernetes.io/component"])
+			require.Equal(t, "k0s", pod.Labels["app.kubernetes.io/managed-by"])
+			// Other resources retain their existing version metadata.
+			require.Contains(t, applier.CommonLabels("other"), "app.kubernetes.io/version")
+			body, err := json.Marshal(pod)
+			require.NoError(t, err)
+			changed, err := json.Marshal(backend.manifest("v2"))
+			require.NoError(t, err)
+			require.NotEqual(t, sha256.Sum256(body), sha256.Sum256(changed), "proxy image changes must remain identity changes")
+			t.Logf("manifest-sha256 %s %x", backend.name, sha256.Sum256(body))
+		})
+	}
+}
