{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageTestBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:GetBucketTagging",
        "s3:ListBucket",
        "s3:DeleteBucket"
      ],
      "Resource": "arn:aws:s3:::${ASSET_BUCKET}"
    },
    {
      "Sid": "ManageTestDownloads",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${ASSET_BUCKET}/downloads/*"
    },
    {
      "Sid": "CreateRestrictedDownloadSession",
      "Effect": "Allow",
      "Action": "sts:GetFederationToken",
      "Resource": "arn:aws:sts::${AWS_ACCOUNT_ID}:federated-user/cldt-assets"
    }
  ]
}
