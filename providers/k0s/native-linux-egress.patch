+// SPDX-FileCopyrightText: 2026 k0s authors
+// SPDX-License-Identifier: Apache-2.0
+
+package controller
+
+import (
+	"github.com/k0sproject/k0s/pkg/apis/k0s/v1beta1"
+	"github.com/k0sproject/k0s/pkg/component/prober"
+	"github.com/k0sproject/k0s/pkg/config"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+	appsv1 "k8s.io/api/apps/v1"
+	corev1 "k8s.io/api/core/v1"
+	rbacv1 "k8s.io/api/rbac/v1"
+	"k8s.io/cli-runtime/pkg/resource"
+	"k8s.io/client-go/kubernetes/scheme"
+	"testing"
+)
+
+func TestKonnectivityLinuxDefaultRoute(t *testing.T) {
+	for _, hostNetwork := range []bool{false, true} {
+		t.Run(map[bool]string{false: "pod-network", true: "host-network"}[hostNetwork], func(t *testing.T) {
+			cfg := v1beta1.DefaultClusterConfig()
+			cfg.Spec.Network.NodeLocalLoadBalancing = &v1beta1.NodeLocalLoadBalancing{Enabled: hostNetwork, Type: v1beta1.NllbTypeTraefik, Traefik: v1beta1.DefaultTraefik()}
+			dir := t.TempDir()
+			agent := KonnectivityAgent{ManifestsDir: dir, KonnectivityServerHost: "192.0.2.1", EventEmitter: prober.NewEventEmitter(), log: logrus.NewEntry(logrus.New())}
+			require.NoError(t, agent.writeKonnectivityAgent(cfg, 3))
+			objects, err := resource.NewLocalBuilder().WithScheme(scheme.Scheme, corev1.SchemeGroupVersion, appsv1.SchemeGroupVersion, rbacv1.SchemeGroupVersion).Path(true, dir).Flatten().Do().Infos()
+			require.NoError(t, err)
+			sets := map[string]*appsv1.DaemonSet{}
+			for _, obj := range objects {
+				if ds, ok := obj.Object.(*appsv1.DaemonSet); ok {
+					sets[ds.Name] = ds
+				}
+			}
+			native := sets["konnectivity-agent"]
+			require.NotNil(t, native)
+			require.Contains(t, native.Spec.Template.Spec.Containers[0].Args, "--agent-identifiers=host=$(NODE_IP)")
+			require.Empty(t, native.Spec.Template.Spec.NodeSelector)
+			linux := sets["konnectivity-agent-default-route-linux"]
+			require.NotNil(t, linux, "Service egress must have a native Linux-only default-route agent")
+			require.Equal(t, map[string]string{"kubernetes.io/os": "linux"}, linux.Spec.Template.Spec.NodeSelector)
+			require.Equal(t, corev1.Linux, linux.Spec.Template.Spec.OS.Name)
+			require.Nil(t, linux.Spec.Template.Spec.SecurityContext.WindowsOptions)
+			require.Equal(t, hostNetwork, linux.Spec.Template.Spec.HostNetwork)
+			require.Equal(t, native.Spec.Template.Spec.ServiceAccountName, linux.Spec.Template.Spec.ServiceAccountName)
+			require.Equal(t, native.Spec.Template.Spec.Volumes, linux.Spec.Template.Spec.Volumes)
+			c := linux.Spec.Template.Spec.Containers[0]
+			require.Equal(t, native.Spec.Template.Spec.Containers[0].Image, c.Image)
+			require.Contains(t, c.Args, "--agent-identifiers=default-route=true")
+			require.Contains(t, c.Args, "--agent-id=default-route-linux-$(NODE_IP)")
+			require.Contains(t, c.Args, "--health-server-port=18095")
+			require.Contains(t, c.Args, "--admin-server-port=18096")
+			require.EqualValues(t, 18095, c.ReadinessProbe.HTTPGet.Port.IntValue())
+			require.EqualValues(t, 18095, c.LivenessProbe.HTTPGet.Port.IntValue())
+			require.NotEqual(t, native.Spec.Selector, linux.Spec.Selector)
+		})
+	}
+}
+
+func TestKonnectivityRejectsUnmatchedWindowsFallback(t *testing.T) {
+	server := Konnectivity{Spec: v1beta1.DefaultKonnectivitySpec(), K0sVars: &config.CfgVars{}}
+	args := server.serverArgs(3)
+	require.Contains(t, args, "--proxy-strategies=destHost,defaultRoute")
+	require.NotContains(t, args, "--proxy-strategies=destHost,defaultRoute,default")
+}
