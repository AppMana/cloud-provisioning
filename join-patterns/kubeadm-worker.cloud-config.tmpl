#cloud-config
# kubeadm-worker join pattern: download the pinned dialer binary, bring
# up the WireGuard tunnel, gate on the cluster's API VIP becoming
# reachable through it, then join as a plain kubeadm worker using a
# pre-minted bootstrap token + CA-hash pin. Set directly as
# Machine.spec.bootstrap.dataSecretName content, with no bootstrap
# provider. kubeadm is one join implementation (kind's control plane is
# kubeadm); k0s-worker.cloud-config.tmpl is another, same contract.
#
# Only write_files and runcmd belong here: CAPD (this pattern's first
# consumer) interprets cloud-config with its own parser, and any other
# top-level module lands in its "unknown" handler, which parses the
# block as JSON and fails on plain YAML. See
# cluster-api/test/infrastructure/docker/internal/provisioning/
# cloudinit/{adapter,unknown}.go. SSH keys, if a kubeadm-over-WAN
# deployment ever needs them, belong in a write_files/runcmd step of a
# dedicated pattern variant, not an ssh_authorized_keys module.
write_files:
  # Same hardened dialer, same separation of concerns as the k0s
  # pattern: pod/service CIDRs only ever enter WireGuard's cryptokey
  # accept-list; kernel routes are /32-/128 host routes to peer nodes,
  # enforced at parse time. This file is the BOOTSTRAP snapshot; the
  # wg-dialer-cloud DaemonSet supplies the live peer list post-join
  # (--machine-name-file resolves this machine's adoption Secret).
  - path: /etc/wg-dialer/peers.json
    permissions: '0600'
    content: |
      {{ .peersFileJSON }}
  - path: /etc/wg-dialer/machine-name
    permissions: '0644'
    content: |
      {{ .machineName }}
  - path: /etc/systemd/system/wg-dialer.service
    permissions: '0644'
    content: |
      [Unit]
      Description=wg-dialer (listener role)
      After=network-online.target
      Wants=network-online.target

      [Service]
      ExecStart=/usr/local/bin/wg-dialer \
        --iface={{ .interfaceName }} \
        --peers-file=/etc/wg-dialer/peers.json \
        --listen-port={{ .wireguardListenPort }} \ \ \
        --keepalive-seconds=15 \
        --mtu=1420 \
        --poll-interval=30s
      Restart=always
      # Re-exec hourly so the unit converges onto whatever binary is at
      # the path: after the node joins, the wg-dialer-cloud DaemonSet
      # installs its own (image-carried, digest-pinned) binary there,
      # which is how upgrades reach this floor without a download host
      # or any per-node action. Restart is <1s and the tunnel config is
      # idempotent, so the re-exec is not a disruption.
      RuntimeMaxSec=1h
      AmbientCapabilities=CAP_NET_ADMIN

      [Install]
      WantedBy=multi-user.target
  # kubelet extra args (role label + internet-facing taint) via the
  # standard systemd drop-in environment file kubeadm's kubelet unit
  # already sources. This keeps the generic kubeletExtraArgs contract
  # without translating it into JoinConfiguration structure.
  - path: /etc/default/kubelet
    permissions: '0644'
    content: |
      KUBELET_EXTRA_ARGS={{ .kubeletExtraArgs }}
runcmd:
  # Pinned-digest binary delivery, identical to the k0s pattern: a
  # mismatch halts the join rather than running unverified code.
  # Download to a temp path and rename into place: a re-run of this
  # bootstrap (cloud-init reruns, an infrastructure provider retrying)
  # would otherwise try to write a binary that is already executing,
  # and the kernel refuses that (ETXTBSY), which curl reports as an
  # opaque write failure. Rename replaces the directory entry and
  # works regardless.
  - |
    set -e
    case "$(uname -m)" in
      aarch64|arm64) url='{{ .dialerBinaryURLArm64 }}'; sha='{{ .dialerBinarySHA256Arm64 }}' ;;
      x86_64|amd64)  url='{{ .dialerBinaryURLAmd64 }}'; sha='{{ .dialerBinarySHA256Amd64 }}' ;;
      *) echo "no wg-dialer build for $(uname -m)" >&2; exit 1 ;;
    esac
    [ -n "$url" ] || { echo "no wg-dialer URL configured for $(uname -m)" >&2; exit 1; }
    curl -fsSL -o /usr/local/bin/.wg-dialer.new "$url"
    echo "$sha  /usr/local/bin/.wg-dialer.new" | sha256sum -c -
    chmod 0755 /usr/local/bin/.wg-dialer.new
    mv -f /usr/local/bin/.wg-dialer.new /usr/local/bin/wg-dialer
  - systemctl daemon-reload
  - systemctl enable --now wg-dialer.service
  # Gate on the API's TCP port rather than ICMP: minimal cloud images
  # ship no ping at all (kindest/node: exit 127) and cloud firewalls
  # routinely drop ICMP while allowing the API port, so a ping gate
  # either loops forever or reports the wrong thing. curl is already a
  # hard dependency of this pattern. Any HTTP response, including
  # 401/403, proves reachability, so no -f here.
  - until curl -sk --max-time 3 -o /dev/null https://{{ .apiEndpoint }}/livez; do sleep 2; done
  - |
    kubeadm join {{ .joinEndpoint }} \
      --token {{ .joinToken }} \
      --discovery-token-ca-cert-hash {{ .caCertHash }} \
      --node-name "$(hostname)"
  # CAPI's bootstrap-success sentinel. Every conformant bootstrap
  # provider writes it and infrastructure providers poll for it to
  # decide the machine is bootstrapped; without it CAPD re-executes
  # this whole userdata forever (a second kubeadm join on an
  # already-joined node then fails, so the Machine never gets its
  # addresses and the endpoint is never mirrored). This pattern IS the
  # bootstrap provider here, so honoring the contract is on us.
  - mkdir -p /run/cluster-api
  - touch /run/cluster-api/bootstrap-success.complete
