+func TestNodeSelectorLabelAdditionUsesExistingInitialization(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	defer ctrl.Finish()
+	mock := NewMock(ctrl, map[string]node.Node{nodeName: unManagedNode})
+	mock.Manager.nodeSelector = labels.SelectorFromSet(labels.Set{"network.example/cni": "aws-vpc"})
+	candidate := v1Node.DeepCopy()
+	candidate.Labels = map[string]string{config.NodeLabelOS: config.OSWindows, "network.example/cni": "aws-vpc"}
+	mock.MockK8sAPI.EXPECT().GetNode(nodeName).Return(candidate, nil)
+	mock.MockConditions.EXPECT().IsWindowsIPAMEnabled().Return(true)
+	gomock.InOrder(
+		mock.MockK8sAPI.EXPECT().GetCNINode(types.NamespacedName{Name: nodeName}).Return(nil, apierrors.NewNotFound(schema.GroupResource{Resource: "cninodes"}, nodeName)),
+		mock.MockK8sAPI.EXPECT().CreateCNINode(candidate, mock.Manager.clusterName, gomock.Any()).Return(nil),
+		mock.MockK8sAPI.EXPECT().GetCNINode(types.NamespacedName{Name: nodeName}).Return(&rcV1alpha1.CNINode{}, nil),
+	)
+	mock.MockWorker.EXPECT().SubmitJob(gomock.All(NewAsyncOperationMatcher(AsyncOperationJob{op: Init, nodeName: nodeName, node: managedNode})))
+	assert.NoError(t, mock.Manager.UpdateNode(nodeName))
+}
