+++ b/plugins/vpc-bridge/config/mtu_test.go
@@ -0,0 +1,26 @@
+package config
+
+import (
+	"fmt"
+	"testing"
+
+	cniSkel "github.com/containernetworking/cni/pkg/skel"
+)
+
+func TestPodMTUAdmission(t *testing.T) {
+	for _, tc := range []struct {
+		raw   string
+		valid bool
+	}{
+		{"0", true}, {"1280", true}, {"1370", true}, {"1420", true},
+		{"1279", false}, {"-1", false}, {"65536", false}, {"1370.5", false}, {`"1370"`, false},
+	} {
+		t.Run(tc.raw, func(t *testing.T) {
+			raw := fmt.Sprintf(`{"eniMACAddress":"02:00:00:00:00:01","podMTU":%s}`, tc.raw)
+			_, err := New(&cniSkel.CmdArgs{StdinData: []byte(raw)}, false)
+			if (err == nil) != tc.valid {
+				t.Fatalf("valid=%v error=%v", tc.valid, err)
+			}
+		})
+	}
+}
