#cloud-config
ssh_authorized_keys:
{{- range .sshAuthorizedKeys }}
  - {{ . }}
{{- end }}
# k0s-worker join pattern: download the pinned dialer binary, bring up
# the WireGuard tunnel, gate on the cluster's API VIP becoming
# reachable through it, then join as a plain k0s worker using a
# pre-minted join token. This is CAPA's own
# Machine.spec.bootstrap.dataSecretName content -- no bootstrap
# provider involved. That's deliberate, not a shortcut: a bootstrap
# provider's whole value is generating this content FOR you from a
# CAPI-managed control plane, and there isn't one here (see
# ../README.md). Every value below comes from the join reconciler's
# render, not from any control-plane object.
write_files:
  # Not wg0.conf/wg-quick: wg-quick auto-installs a kernel route for
  # every AllowedIPs entry -- the exact mechanism of the 2026-07-22
  # route-hijack incident. The same hardened Go dialer binary that runs
  # on-prem runs here instead (listener role, systemd unit below): pod/
  # service CIDRs go only into WireGuard's cryptokey accept-list, and
  # the only kernel routes it will ever install are /32 and /128 host
  # routes to peer node addresses, enforced at parse time.
  #
  # This file is the BOOTSTRAP snapshot: identity (this node's private
  # key + tunnel address, which never travel through the API) plus the
  # peer list as of render time. Post-join, the wg-dialer-cloud
  # DaemonSet feeds the same dialer a live peer list from an in-cluster
  # Secret (--machine-name-file below resolves which one) -- that
  # adoption path, not this frozen file, is how peer/CIDR corrections
  # reach a node whose userdata is immutable. The systemd unit is never
  # disabled: if the DaemonSet can't schedule, this file remains the
  # floor that keeps the node reachable.
  - path: /etc/wg-dialer/peers.json
    permissions: '0600'
    content: |
      {{ .peersFileJSON }}
  # The CAPI Machine name, for the adoption path: the DaemonSet's one
  # shared pod spec derives this machine's own adoption Secret name
  # from this node-local file.
  - path: /etc/wg-dialer/machine-name
    permissions: '0644'
    content: |
      {{ .machineName }}
  - path: /etc/systemd/system/wg-dialer.service
    permissions: '0644'
    content: |
      [Unit]
      Description=wg-dialer (listener role)
      After=network-online.target
      Wants=network-online.target

      [Service]
      ExecStart=/usr/local/bin/wg-dialer \
        --iface={{ .interfaceName }} \
        --peers-file=/etc/wg-dialer/peers.json \
        --listen-port={{ .wireguardListenPort }} \
        --pod-cidrs={{ .podCIDRs }} \
        --service-cidrs={{ .serviceCIDRs }} \
        --keepalive-seconds=15 \
        --mtu=1420 \
        --poll-interval=30s
      Restart=always
      # Re-exec hourly so the unit converges onto whatever binary is at
      # the path: after the node joins, the wg-dialer-cloud DaemonSet
      # installs its own (image-carried, digest-pinned) binary there,
      # which is how upgrades reach this floor without a download host
      # or any per-node action. Restart is <1s and the tunnel config is
      # idempotent, so the re-exec is not a disruption.
      RuntimeMaxSec=1h
      AmbientCapabilities=CAP_NET_ADMIN

      [Install]
      WantedBy=multi-user.target
  - path: /etc/k0s/join-token
    permissions: '0600'
    content: |
      {{ .joinToken }}
runcmd:
  # A stock cloud image has no wg-dialer: download the per-arch release
  # binary and verify its digest BEFORE anything depends on it. The
  # sha256 is pinned into this (immutable) userdata at render time, so
  # a compromised download host cannot swap the binary -- a mismatch
  # halts the join rather than running unverified code.
  # Download to a temp path and RENAME into place: a re-run of this
  # bootstrap (cloud-init reruns, an infrastructure provider retrying)
  # would otherwise try to write a binary that is already executing,
  # and the kernel refuses that (ETXTBSY) -- curl reports it as an
  # opaque write failure. Rename replaces the directory entry and
  # works regardless.
  - |
    set -e
    curl -fsSL -o /usr/local/bin/.wg-dialer.new '{{ .dialerBinaryURL }}'
    echo '{{ .dialerBinarySHA256 }}  /usr/local/bin/.wg-dialer.new' | sha256sum -c -
    chmod 0755 /usr/local/bin/.wg-dialer.new
    mv -f /usr/local/bin/.wg-dialer.new /usr/local/bin/wg-dialer
  - systemctl enable --now wg-dialer.service
  # Gate on the API's TCP port, NOT on ICMP: minimal cloud images may
  # ship no ping at all, and cloud firewalls routinely drop ICMP while
  # allowing the API port, so a ping gate either loops forever or
  # reports the wrong thing. curl is already a hard dependency of this
  # pattern. Any HTTP response -- including 401/403 -- proves
  # reachability, so no -f here.
  - until curl -sk --max-time 3 -o /dev/null https://{{ .apiEndpoint }}/livez; do sleep 2; done
  # The cluster's CNI configuration CHAINS standard plugins. Confirmed
  # on this fleet: 10-calico.conflist is calico -> calico-ipam -> k8s
  # -> portmap -> bandwidth. Calico's install-cni ships calico,
  # calico-ipam, flannel, host-local, loopback, portmap and tuning --
  # but NOT bandwidth, and k0s bundles only containerd/kubelet/iptables/
  # runc. On existing nodes bandwidth was placed there by whatever
  # provisioned them; a freshly provisioned node has no way to get it,
  # and every pod sandbox then fails with 'failed to find plugin
  # "bandwidth" in path [/opt/cni/bin]'.
  #
  # Fills GAPS only: a plugin Calico already installed is left alone,
  # so this never downgrades calico-ipam or portmap to the upstream
  # build underneath a running CNI.
  {{- if .cniPluginsURL }}
  - |
    set -e
    mkdir -p /opt/cni/bin /tmp/cni-plugins
    curl -fsSL -o /tmp/cni-plugins.tgz '{{ .cniPluginsURL }}'
    echo '{{ .cniPluginsSHA256 }}  /tmp/cni-plugins.tgz' | sha256sum -c -
    tar -C /tmp/cni-plugins -xzf /tmp/cni-plugins.tgz
    for f in /tmp/cni-plugins/*; do
      [ -e "/opt/cni/bin/$(basename "$f")" ] || cp -a "$f" /opt/cni/bin/
    done
    rm -rf /tmp/cni-plugins /tmp/cni-plugins.tgz
  {{- end }}
  - curl -sSLf https://get.k0s.sh | K0S_VERSION={{ .k0sVersion }} sh
  # k0s resolves node IPs by looking up the instance's own hostname, not
  # by inspecting interfaces -- on AWS that hostname only maps to the
  # private IPv4 in /etc/hosts, so a dual-stack cluster's kubelet fails
  # to start ("IP address lookup didn't return addresses for both
  # families") even when the interface genuinely has a real IPv6 GUA.
  # --node-ip bypasses that lookup with addresses fetched directly from
  # instance metadata instead. (IMDSv2, AWS-specific: a different
  # infrastructure provider's variant of this pattern would fetch its
  # own metadata service here instead.)
  - |
    IMDS_TOKEN=$(curl -sSf -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
    NODE_IPV4=$(curl -sSf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)
    NODE_IPV6=$(curl -sSf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/ipv6 || true)
    NODE_IP_ARG="--node-ip=$NODE_IPV4"
    [ -n "$NODE_IPV6" ] && NODE_IP_ARG="--node-ip=$NODE_IPV4,$NODE_IPV6"
    k0s install worker --token-file /etc/k0s/join-token --kubelet-extra-args="{{ .kubeletExtraArgs }} $NODE_IP_ARG"
  - k0s start
  # CAPI's bootstrap-success sentinel. Every conformant bootstrap
  # provider writes it and infrastructure providers poll for it to
  # decide the machine is bootstrapped; without it an infrastructure
  # provider can re-execute this whole userdata forever. This pattern
  # IS the bootstrap provider here, so honoring the contract is on us.
  - mkdir -p /run/cluster-api
  - touch /run/cluster-api/bootstrap-success.complete
